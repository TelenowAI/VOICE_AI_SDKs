{
  "name": "@telenow/server",
  "version": "0.1.4",
  "description": "Telenow voice AI SDK for Node, Bun, Deno & edge — place AI agent phone calls, mint browser/app call sessions, transfer & end live calls, verify webhooks, and build custom-LLM streaming (SSE) endpoints. Zero dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "node --test",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "voice-ai",
    "ai-voice-agent",
    "voice-agent",
    "ai-phone-call",
    "outbound-calls",
    "call-automation",
    "call-center",
    "conversational-ai",
    "voice-bot",
    "telephony",
    "ai-agent",
    "llm",
    "custom-llm",
    "sse",
    "server-sent-events",
    "webhooks",
    "api-client",
    "nodejs",
    "bun",
    "deno",
    "cloudflare-workers",
    "telenow"
  ],
  "license": "MIT",
  "author": "Telenow (https://telenow.ai)",
  "homepage": "https://telenow.ai/docs/sdk-server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TelenowAI/VOICE_AI_SDKs.git",
    "directory": "server-node"
  },
  "bugs": {
    "url": "https://github.com/TelenowAI/VOICE_AI_SDKs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.6.2"
  }
}
