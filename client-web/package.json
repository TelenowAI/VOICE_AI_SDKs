{
  "name": "@telenow/client",
  "version": "0.1.4",
  "description": "Telenow voice AI SDK for the browser — add real-time AI voice agent calls to any web app: mic capture, echo & noise suppression, adaptive jitter buffer, barge-in, auto-reconnect, live transcripts. WebSocket or WebRTC transport (chosen by the agent, transparent to your code — WebRTC support is built in). Framework-agnostic.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "voice-ai",
    "ai-voice-agent",
    "voice-agent",
    "conversational-ai",
    "voice-assistant",
    "voice-bot",
    "ai-call",
    "call-automation",
    "call-center",
    "ivr",
    "telephony",
    "speech-to-text",
    "text-to-speech",
    "stt",
    "tts",
    "real-time",
    "websocket",
    "audio-streaming",
    "microphone",
    "jitter-buffer",
    "barge-in",
    "web-audio",
    "voice-sdk",
    "telenow"
  ],
  "license": "MIT",
  "author": "Telenow (https://telenow.ai)",
  "homepage": "https://telenow.ai/docs/sdk-web",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TelenowAI/VOICE_AI_SDKs.git",
    "directory": "client-web"
  },
  "bugs": {
    "url": "https://github.com/TelenowAI/VOICE_AI_SDKs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "livekit-client": "^2.20.0"
  },
  "devDependencies": {
    "typescript": "^5.6.2"
  }
}
