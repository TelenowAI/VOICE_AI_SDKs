{
    "baseUrl": "{{connection.baseUrl}}",
    "headers": {
        "x-api-key": "{{connection.apiKey}}"
    },
    "response": {
        "error": {
            "message": "[{{statusCode}}] {{ifempty(body.error, body)}}"
        }
    },
    "log": {
        "sanitize": [
            "request.headers.x-api-key"
        ]
    }
}
